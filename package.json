{
  "name": "stupdt",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "StuPDT — Stupid. Fast. Wrong. A satirical multi-department AI bureaucracy simulator.",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "backend": "uvicorn backend.app.main:app --reload --host 127.0.0.1 --port 8000",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "test:api": "node --test api/tests/*.test.js",
    "test:backend": "pytest backend/tests",
    "test": "node --test api/tests/*.test.js && pytest backend/tests"
  }
}
