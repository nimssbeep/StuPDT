# Optional: Add your Gemini API key in Vercel Project Settings -> Environment Variables
# to enable live AI chat & image detection. Without a key, StuPDT runs seamlessly
# using its built-in deterministic responses.

# Preferred for Vercel deployments (kept private on the server via /api/gemini):
GEMINI_API_KEY=

# Optional model override (defaults to gemini-3-flash-preview):
# GEMINI_MODEL=gemini-3-flash-preview

# Optional for local `npm run dev` without Vercel CLI:
# VITE_GEMINI_API_KEY=
